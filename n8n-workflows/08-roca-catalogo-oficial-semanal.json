{
  "id": "EnlazeRocaWeekly26",
  "name": "ENLAZE - Roca catálogo oficial semanal",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 4 * * 1"
            }
          ]
        }
      },
      "id": "a2f2cf07-3454-4c0d-a84d-563e759e7ef6",
      "name": "Cada lunes 04:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 260]
    },
    {
      "parameters": {},
      "id": "73b2a873-4cc4-4a8c-b1ad-1dd80dbebed4",
      "name": "Prueba manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [260, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8765/run/roca/send",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 900000
        }
      },
      "id": "a15372bc-4d08-44ce-a10f-3c80c00b9c28",
      "name": "Actualizar catálogo oficial Roca",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 340],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 60000,
      "notes": "El worker solo escucha en localhost y conserva la clave de ENLAZE fuera de n8n. Timeout de 15 minutos para descargar, validar e importar el catálogo completo."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "eefe675c-3b7b-4f57-953a-5190c206691b",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "eb039f70-4a13-4801-aeb5-5f3c9cdf2c74",
      "name": "Importación correcta",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [820, 340]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={\n  \"resultado\": \"CATÁLOGO ROCA ACTUALIZADO\",\n  \"productos\": {{ $json.body.products || 0 }},\n  \"fecha_catalogo\": \"{{ $json.body.catalog_published_at || '' }}\",\n  \"insertados\": {{ $json.body.ingest?.inserted || 0 }},\n  \"actualizados\": {{ $json.body.ingest?.updated || 0 }},\n  \"errores\": {{ $json.body.ingest?.errors || 0 }}\n}",
        "options": {}
      },
      "id": "e69a45af-c28e-4ebd-8707-c29a25dd574d",
      "name": "Resumen correcto",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1080, 260]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={\n  \"resultado\": \"ERROR ACTUALIZANDO ROCA\",\n  \"estado_http\": {{ $json.statusCode || 0 }},\n  \"detalle\": {{ JSON.stringify($json.body?.error || $json.body || 'Sin detalle') }}\n}",
        "options": {}
      },
      "id": "1cc63aeb-45ea-489f-a6da-29be52c53bef",
      "name": "Resumen error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1080, 440]
    }
  ],
  "connections": {
    "Cada lunes 04:00": {
      "main": [[{"node": "Actualizar catálogo oficial Roca", "type": "main", "index": 0}]]
    },
    "Prueba manual": {
      "main": [[{"node": "Actualizar catálogo oficial Roca", "type": "main", "index": 0}]]
    },
    "Actualizar catálogo oficial Roca": {
      "main": [[{"node": "Importación correcta", "type": "main", "index": 0}]]
    },
    "Importación correcta": {
      "main": [
        [{"node": "Resumen correcto", "type": "main", "index": 0}],
        [{"node": "Resumen error", "type": "main", "index": 0}]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Madrid",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": []
}
