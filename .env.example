# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno de Enlaze. Copia este fichero a .env.local y rellénalo.
# NUNCA pongas valores reales aquí: este fichero se sube al repositorio.
# Los secretos se generan con: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (obligatorias) ─────────────────────────────────────────────────
# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role: SECRETA, solo servidor. También hace falta en el BUILD de
# Vercel: `npm run build` comprueba plan_catalog contra lib/plans.ts.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sitio ───────────────────────────────────────────────────────────────────
# Local: http://localhost:3000 · Producción: https://enlaze.es
NEXT_PUBLIC_SITE_URL=
# URL de la app usada en enlaces de emails de avisos (normalmente = SITE_URL)
NEXT_PUBLIC_APP_URL=

# ── IA (Anthropic) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Opcional: modelo del OCR de facturas (por defecto el del código)
ANTHROPIC_OCR_MODEL=
# Opcionales: topes diarios de tokens (por defecto 5000 / 60000 / 600000)
AI_BUDGET_MAX_OUTPUT_TOKENS=
AI_BUDGET_DAILY_TOKENS_PER_USER=
AI_BUDGET_DAILY_TOKENS_GLOBAL=

# ── Pagos (Stripe) — SOLO claves de PRUEBA mientras no haya entidad legal ───
# Mejor una clave restringida (rk_test_…). Una clave real (*_live_) se rechaza
# salvo STRIPE_LIVE_MODE=1 (no lo definas por ahora).
STRIPE_SECRET_KEY=
# Secreto de firma de /api/billing/webhook (whsec_…). SIN ÉL EL WEBHOOK
# RESPONDE 500 Y NO PROCESA NADA: no hay valor por defecto, a propósito.
# En local lo imprime `stripe listen`; en producción, el endpoint del Dashboard.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_LIVE_MODE=
# Price IDs (price_…), uno por plan y periodicidad. Los importes mandan en
# lib/plans.ts; `npm run build` falla si Stripe no coincide.
STRIPE_PRICE_BASICO_MONTHLY=
STRIPE_PRICE_BASICO_YEARLY=
STRIPE_PRICE_PROFESIONAL_MONTHLY=
STRIPE_PRICE_PROFESIONAL_YEARLY=
STRIPE_PRICE_EMPRESA_MONTHLY=
STRIPE_PRICE_EMPRESA_YEARLY=

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── Google (login, Gmail, Calendar, Sheets) ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cifra los tokens OAuth guardados (64 caracteres hex: openssl rand -hex 32)
OAUTH_ENCRYPTION_KEY=
# Firma el parámetro state del flujo OAuth
OAUTH_STATE_SECRET=

# ── WhatsApp (Meta Cloud API) ───────────────────────────────────────────────
# Opcional: versión de la Graph API (por defecto la del código)
WHATSAPP_GRAPH_API_VERSION=

# ── n8n, agente y sincronización de precios ─────────────────────────────────
# Bearer que usa n8n contra /api/agent/* y /api/pb/*
AGENT_API_KEY=
# Secreto de los webhooks de n8n
WEBHOOK_SECRET=
# Clave de /api/pb/ingest y /api/prices/n8n-sync (scrapers)
SYNC_API_KEY=
# Secreto de /api/cron/dispatch-scheduled (envíos programados de WhatsApp y
# email). Se manda como `Authorization: Bearer <secreto>` o `x-cron-secret`.
CRON_SECRET=
# Opcionales del agente (por defecto 14 días / los minutos del código)
AGENT_INACTIVE_DAYS=
AGENT_SUMMARY_CACHE_TTL_MINUTES=
# Búsqueda de precios de mercado
SERP_API_KEY=
N8N_PRICE_SEARCH_WEBHOOK_URL=

# ── Analítica (PostHog) ─────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ── Herramientas de desarrollo ──────────────────────────────────────────────
# "true" para ver /dashboard/dev/agent-inspector
NEXT_PUBLIC_DEV_TOOLS_ENABLED=

# ── Solo para scripts/ (scrapers e importaciones; la app no las usa) ────────
PRICE_INGEST_URL=
PRICE_SYNC_REQUEST_URL=
VERCEL_AUTOMATION_BYPASS_SECRET=
LEROY_AUTHORIZATION_REFERENCE=
INGEST_BATCH_SIZE=
